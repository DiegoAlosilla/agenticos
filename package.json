{
  "name": "agenticos-channel-design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": "24.18.x"},
  "scripts": {
    "channel": "node src/channel-cli.mjs",
    "channel:editor": "node src/channel-cli.mjs editor",
    "channel:demo": "node src/channel-cli.mjs demo",
    "orchestrate": "node src/orchestration-cli.mjs",
    "orchestrate:demo": "node scripts/orchestration-demo.mjs",
    "orchestrate:diagram": "node src/orchestration-cli.mjs diagram",
    "test:orchestration": "npm --prefix editor run build && node --test tests/orchestration.test.mjs",
    "test:orchestration:browser": "node tests/orchestration-browser.mjs",
    "test": "npm run test:orchestration && npm --prefix editor test"
  },
  "dependencies": {"yaml": "2.9.1"}
}
